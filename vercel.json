{
  "cleanUrls": false,
  "redirects": [
    { "source": "/comment.html", "destination": "/html/comment.html", "permanent": true },
    { "source": "/unit.html", "destination": "/html/unit.html", "permanent": true },
    { "source": "/notes.html", "destination": "/html/notes.html", "permanent": true },
    { "source": "/photo.html", "destination": "/html/photo.html", "permanent": true },
    { "source": "/pdf.html", "destination": "/html/pdf.html", "permanent": true },
    { "source": "/layout/:path*", "destination": "/html/:path*", "permanent": true },
    { "source": "/profile", "destination": "/html/profile.html", "permanent": true },
    { "source": "/profile/", "destination": "/html/profile.html", "permanent": true },
    { "source": "/profile/index.html", "destination": "/html/profile.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/firebase-config.js", "destination": "/api/env?bundle=1" },
    { "source": "/post/:id", "destination": "/api/share?type=post&id=:id" },
    { "source": "/post/:id/", "destination": "/api/share?type=post&id=:id" },
    { "source": "/durbar/post/:id", "destination": "/api/share?type=post&id=:id" },
    { "source": "/durbar/post/:id/", "destination": "/api/share?type=post&id=:id" },
    { "source": "/shorts/:id", "destination": "/api/share?type=shorts&id=:id" },
    { "source": "/shorts/:id/", "destination": "/api/share?type=shorts&id=:id" },
    { "source": "/durbar/shorts/:id", "destination": "/api/share?type=shorts&id=:id" },
    { "source": "/durbar/shorts/:id/", "destination": "/api/share?type=shorts&id=:id" },
    { "source": "/user/:id", "destination": "/api/share?type=user&id=:id" },
    { "source": "/user/:id/", "destination": "/api/share?type=user&id=:id" },
    { "source": "/durbar/user/:id", "destination": "/api/share?type=user&id=:id" },
    { "source": "/durbar/user/:id/", "destination": "/api/share?type=user&id=:id" }
  ],
  "headers": [
    {
      "source": "/post",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/post/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/post/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}